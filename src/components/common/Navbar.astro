---
import MorphIcon from "morphicons/astro";
import { Menu } from "lucide";
import { whatsappUrl } from "../../lib/constants";
import Logo from "./Logo.astro";

interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
const isDarkInitial = theme === "dark";
---

<!-- NAVBAR PRINCIPAL -->
<header
  id="main-navbar"
  data-theme={theme}
  class={`fixed top-0 left-0 w-full z-50 transition-colors duration-200 py-5 px-6 md:px-12 ${
    isDarkInitial ? "mode-scrolled" : "mode-transparent"
  }`}
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- BRANDING LOGO -->
    <Logo variant="full" size="md" />

    <!-- LINKS DE NAVEGACIÓN DESKTOP -->
    <nav class="hidden md:flex items-center space-x-8">
      <a
        href="/"
        class="nav-link text-xs uppercase tracking-[0.2em] font-sans transition-colors duration-200 font-medium"
        >Home</a
      >
      <a
        href="/#services"
        class="nav-link text-xs uppercase tracking-[0.2em] font-sans transition-colors duration-200 font-medium"
        >Treatments</a
      >
      <a
        href="/#experience"
        class="nav-link text-xs uppercase tracking-[0.2em] font-sans transition-colors duration-200 font-medium"
        >The Experience</a
      >
      <a
        href="/about"
        class="nav-link text-xs uppercase tracking-[0.2em] font-sans transition-colors duration-200 font-medium"
        >About Us</a
      >
    </nav>

    <!-- CTA BOTÓN DESKTOP -->
    <div class="hidden md:block">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-btn text-xs uppercase tracking-[0.15em] font-sans font-semibold px-6 py-2.5 rounded-full transition-all duration-200 backdrop-blur-sm border cursor-pointer"
      >
        Book Now
      </a>
    </div>

    <!-- BOTÓN TRIGGER MOBILE CON MORPHICONS -->
    <button
      id="mobile-menu-trigger"
      type="button"
      aria-label="Toggle Menu"
      aria-expanded="false"
      class="md:hidden relative z-50 w-11 h-11 flex items-center justify-center backdrop-blur-md border rounded-full transition-all duration-200 cursor-pointer select-none"
    >
      <div
        class="trigger-icon-wrapper w-6 h-6 flex items-center justify-center"
      >
        <MorphIcon icon={Menu} stroke-width="1.8" />
      </div>
    </button>
  </div>
</header>

<!-- MENÚ MOBILE OVERLAY -->
<div
  id="mobile-overlay"
  class="fixed inset-0 bg-serene-cream/98 backdrop-blur-2xl z-40 flex flex-col justify-between p-8 pt-28 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
>
  <div class="flex flex-col space-y-6 text-center">
    <a
      href="/"
      class="mobile-nav-link text-3xl font-serif text-serene-navy hover:text-serene-gold transition-colors"
      >Home</a
    >
    <a
      href="/#services"
      class="mobile-nav-link text-3xl font-serif text-serene-navy hover:text-serene-gold transition-colors"
      >Treatments</a
    >
    <a
      href="/#experience"
      class="mobile-nav-link text-3xl font-serif text-serene-navy hover:text-serene-gold transition-colors"
      >The Experience</a
    >
    <a
      href="/about"
      class="mobile-nav-link text-3xl font-serif text-serene-navy hover:text-serene-gold transition-colors"
      >About Us</a
    >
  </div>

  <div class="flex flex-col items-center space-y-4 pb-8">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full text-center bg-serene-navy text-serene-cream font-sans text-xs uppercase tracking-widest font-semibold py-4 rounded-full shadow-lg cursor-pointer"
    >
      Book via WhatsApp
    </a>
    <p class="text-[10px] uppercase tracking-widest text-serene-tan font-sans">
      At-Home Luxury Wellness • Dubai
    </p>
  </div>
</div>

<style>
  /* CONTROL DE LOGO SEGÚN MODO Y ESTADO DEL MENÚ */
  header.mode-transparent:not(.menu-open) .logo-img-cream {
    display: block !important;
  }
  header.mode-transparent:not(.menu-open) .logo-img-navy {
    display: none !important;
  }

  header.mode-scrolled .logo-img-cream,
  header.menu-open .logo-img-cream {
    display: none !important;
  }
  header.mode-scrolled .logo-img-navy,
  header.menu-open .logo-img-navy {
    display: block !important;
  }

  /* MODO TRANSPARENTE */
  header.mode-transparent:not(.menu-open) .nav-link {
    color: #fdfcf9 !important;
  }
  header.mode-transparent:not(.menu-open) .nav-btn {
    border-color: rgba(223, 196, 154, 0.6) !important;
    color: #fdfcf9 !important;
  }
  header.mode-transparent:not(.menu-open) #mobile-menu-trigger {
    border-color: rgba(223, 196, 154, 0.4) !important;
    background-color: rgba(253, 252, 249, 0.1) !important;
    color: #fdfcf9 !important;
  }

  /* MODO SCROLLED (BARRA CLARA) */
  header.mode-scrolled {
    background-color: rgba(245, 240, 232, 0.96) !important;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(9, 13, 61, 0.06);
    padding-top: 0.75rem !important;
    padding-bottom: 0.75rem !important;
  }
  header.mode-scrolled .nav-link {
    color: #090d3d !important;
  }
  header.mode-scrolled .nav-btn {
    border-color: rgba(9, 13, 61, 0.3) !important;
    color: #090d3d !important;
  }
  header.mode-scrolled #mobile-menu-trigger {
    border-color: rgba(9, 13, 61, 0.2) !important;
    background-color: rgba(9, 13, 61, 0.05) !important;
    color: #090d3d !important;
  }

  /* CUANDO EL OVERLAY ESTÁ ABIERTO: CONTRASTE ALTO SIEMPRE */
  header.menu-open #mobile-menu-trigger {
    border-color: rgba(9, 13, 61, 0.25) !important;
    background-color: rgba(9, 13, 61, 0.08) !important;
    color: #090d3d !important;
  }

  /* Ajuste de color del stroke de MorphIcon */
  #mobile-menu-trigger morph-icon,
  #mobile-menu-trigger svg {
    stroke: currentColor;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { Menu, X } from "lucide";
  import type { MorphIconElement } from "morphicons/element";

  window.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("main-navbar");
    const heroSection = document.getElementById("hero-section");
    const mobileTrigger = document.querySelector<HTMLButtonElement>(
      "#mobile-menu-trigger",
    );
    const morphIcon =
      mobileTrigger?.querySelector<MorphIconElement>("morph-icon");
    const mobileOverlay = document.getElementById("mobile-overlay");
    const theme = navbar?.getAttribute("data-theme") || "light";

    let isMenuOpen = false;
    let lastScrollY = window.scrollY;

    const closeMenu = () => {
      if (!isMenuOpen) return;
      isMenuOpen = false;
      mobileTrigger?.setAttribute("aria-expanded", "false");
      if (morphIcon) morphIcon.icon = Menu;

      navbar?.classList.remove("menu-open");
      mobileOverlay?.classList.add("opacity-0", "pointer-events-none");
      mobileOverlay?.classList.remove("opacity-100", "pointer-events-auto");
      document.body.classList.remove("overflow-hidden");
    };

    const openMenu = () => {
      isMenuOpen = true;
      mobileTrigger?.setAttribute("aria-expanded", "true");
      if (morphIcon) morphIcon.icon = X;

      navbar?.classList.add("menu-open");
      mobileOverlay?.classList.remove("opacity-0", "pointer-events-none");
      mobileOverlay?.classList.add("opacity-100", "pointer-events-auto");
      document.body.classList.add("overflow-hidden");
    };

    // Scroll handling
    const handleScroll = () => {
      const currentScrollY = window.scrollY;

      if (theme === "dark") {
        navbar?.classList.add("mode-scrolled");
        navbar?.classList.remove("mode-transparent");
      } else {
        const heroHeight = heroSection ? heroSection.offsetHeight - 90 : 500;
        if (currentScrollY >= heroHeight) {
          navbar?.classList.add("mode-scrolled");
          navbar?.classList.remove("mode-transparent", "py-5");
        } else {
          navbar?.classList.add("mode-transparent", "py-5");
          navbar?.classList.remove("mode-scrolled");
        }
      }

      if (currentScrollY > lastScrollY && currentScrollY > 120 && !isMenuOpen) {
        gsap.to(navbar, { yPercent: -100, duration: 0.2, ease: "power2.out" });
      } else if (currentScrollY < lastScrollY && !isMenuOpen) {
        gsap.to(navbar, { yPercent: 0, duration: 0.2, ease: "power2.out" });
      }

      lastScrollY = currentScrollY;
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    // Toggle Mobile Trigger
    mobileTrigger?.addEventListener("click", () => {
      if (isMenuOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Cerrar al dar click a cualquier link del overlay
    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });
  });
</script>

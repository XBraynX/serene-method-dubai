---
import { whatsappUrl } from "../../lib/constants";
import Logo from "./Logo.astro";

interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
const isDarkInitial = theme === "dark";
---

<!-- NAVBAR PRINCIPAL -->
<header
  id="main-navbar"
  data-theme={theme}
  class={`fixed top-0 left-0 w-full z-50 transition-colors duration-200 py-5 px-6 md:px-12 ${
    isDarkInitial ? "mode-scrolled" : "mode-transparent"
  }`}
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- BRANDING LOGO -->

    <Logo variant="full" size="md" />

    <!-- LINKS DE NAVEGACIÓN DESKTOP -->
    <nav class="hidden md:flex items-center space-x-8">
      <a
        href="/"
        class="nav-link text-xs uppercase tracking-[0.2em] font-sans transition-colors duration-200 font-medium"
        >Home</a
      >
      <a
        href="/#services"
        class="nav-link text-xs uppercase tracking-[0.2em] font-sans transition-colors duration-200 font-medium"
        >Treatments</a
      >
      <a
        href="/#experience"
        class="nav-link text-xs uppercase tracking-[0.2em] font-sans transition-colors duration-200 font-medium"
        >The Experience</a
      >
      <a
        href="/about"
        class="nav-link text-xs uppercase tracking-[0.2em] font-sans transition-colors duration-200 font-medium"
        >About Us</a
      >
    </nav>

    <!-- CTA BOTÓN DESKTOP -->
    <div class="hidden md:block">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-btn text-xs uppercase tracking-[0.15em] font-sans font-semibold px-6 py-2.5 rounded-full transition-all duration-200 backdrop-blur-sm border cursor-pointer"
      >
        Book Now
      </a>
    </div>

    <!-- BOTÓN TRIGGER MOBILE -->
    <button
      id="mobile-menu-trigger"
      aria-label="Toggle Menu"
      class="md:hidden relative z-50 w-10 h-10 flex flex-col justify-center items-center space-y-1.5 backdrop-blur-md border rounded-full p-2 transition-colors duration-200 cursor-pointer"
    >
      <span class="line-1 w-5 h-[1.5px] transition-transform duration-200"
      ></span>
      <span class="line-2 w-3 h-[1.5px] transition-transform duration-200"
      ></span>
    </button>
  </div>
</header>

<!-- MENÚ MOBILE OVERLAY -->
<div
  id="mobile-overlay"
  class="fixed inset-0 bg-serene-cream/98 backdrop-blur-2xl z-40 flex flex-col justify-between p-8 pt-28 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
>
  <div class="flex flex-col space-y-6 text-center">
    <a
      href="/"
      class="mobile-nav-item text-3xl font-serif text-serene-navy hover:text-serene-gold transition-colors"
      >Home</a
    >
    <a
      href="/#services"
      class="mobile-nav-item text-3xl font-serif text-serene-navy hover:text-serene-gold transition-colors"
      >Treatments</a
    >
    <a
      href="/#experience"
      class="mobile-nav-item text-3xl font-serif text-serene-navy hover:text-serene-gold transition-colors"
      >The Experience</a
    >
    <a
      href="/about"
      class="mobile-nav-item text-3xl font-serif text-serene-navy hover:text-serene-gold transition-colors"
      >About Us</a
    >
  </div>

  <div class="flex flex-col items-center space-y-4 pb-8">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full text-center bg-serene-navy text-serene-cream font-sans text-xs uppercase tracking-widest font-semibold py-4 rounded-full shadow-lg cursor-pointer"
    >
      Book via WhatsApp
    </a>
    <p class="text-[10px] uppercase tracking-widest text-serene-tan font-sans">
      At-Home Luxury Wellness • Dubai
    </p>
  </div>
</div>

<style>
  /* CONTROL DE MOSTRAR / OCULTAR LOGO SEGÚN EL MODO */
  header.mode-transparent .logo-img-cream {
    display: block !important;
  }
  header.mode-transparent .logo-img-navy {
    display: none !important;
  }

  header.mode-scrolled .logo-img-cream {
    display: none !important;
  }
  header.mode-scrolled .logo-img-navy {
    display: block !important;
  }

  /* MODO TRANSPARENTE (HERO) */
  header.mode-transparent .nav-link {
    color: #fdfcf9 !important;
  }
  header.mode-transparent .nav-link:hover {
    color: #dfc49a !important;
  }
  header.mode-transparent .nav-btn {
    border-color: rgba(223, 196, 154, 0.6) !important;
    color: #fdfcf9 !important;
  }
  header.mode-transparent .nav-btn:hover {
    background-color: #dfc49a !important;
    color: #090d3d !important;
  }
  header.mode-transparent #mobile-menu-trigger {
    border-color: rgba(223, 196, 154, 0.4) !important;
    background-color: rgba(253, 252, 249, 0.1) !important;
  }
  header.mode-transparent #mobile-menu-trigger span {
    background-color: #fdfcf9 !important;
  }

  /* MODO SCROLLED (SECCIONES CLARAS / PÁGINAS INTERNAS) */
  header.mode-scrolled {
    background-color: rgba(245, 240, 232, 0.96) !important;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(9, 13, 61, 0.06);
    padding-top: 0.75rem !important;
    padding-bottom: 0.75rem !important;
  }

  header.mode-scrolled .nav-link {
    color: #090d3d !important;
  }
  header.mode-scrolled .nav-link:hover {
    color: #beaa8e !important;
  }
  header.mode-scrolled .nav-btn {
    border-color: rgba(9, 13, 61, 0.3) !important;
    color: #090d3d !important;
  }
  header.mode-scrolled .nav-btn:hover {
    background-color: #090d3d !important;
    color: #fdfcf9 !important;
  }
  header.mode-scrolled #mobile-menu-trigger {
    border-color: rgba(9, 13, 61, 0.2) !important;
    background-color: rgba(9, 13, 61, 0.05) !important;
  }
  header.mode-scrolled #mobile-menu-trigger span {
    background-color: #090d3d !important;
  }
</style>

<script>
  import { gsap } from "gsap";

  window.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("main-navbar");
    const heroSection = document.getElementById("hero-section");
    const mobileTrigger = document.getElementById("mobile-menu-trigger");
    const mobileOverlay = document.getElementById("mobile-overlay");
    const theme = navbar?.getAttribute("data-theme") || "light";

    let isMenuOpen = false;
    let lastScrollY = window.scrollY;

    const handleScroll = () => {
      const currentScrollY = window.scrollY;

      // Si la página tiene tema oscuro forzado (ej: About Us) permanece siempre en mode-scrolled
      if (theme === "dark") {
        navbar?.classList.add("mode-scrolled");
        navbar?.classList.remove("mode-transparent");
      } else {
        const heroHeight = heroSection ? heroSection.offsetHeight - 90 : 500;
        if (currentScrollY >= heroHeight) {
          navbar?.classList.add("mode-scrolled");
          navbar?.classList.remove("mode-transparent", "py-5");
        } else {
          navbar?.classList.add("mode-transparent", "py-5");
          navbar?.classList.remove("mode-scrolled");
        }
      }

      // Slide suave al ocultar/mostrar en scroll
      if (currentScrollY > lastScrollY && currentScrollY > 120 && !isMenuOpen) {
        gsap.to(navbar, { yPercent: -100, duration: 0.2, ease: "power2.out" });
      } else if (currentScrollY < lastScrollY && !isMenuOpen) {
        gsap.to(navbar, { yPercent: 0, duration: 0.2, ease: "power2.out" });
      }

      lastScrollY = currentScrollY;
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    // Toggle Menú Mobile
    mobileTrigger?.addEventListener("click", () => {
      isMenuOpen = !isMenuOpen;

      if (isMenuOpen) {
        mobileOverlay?.classList.remove("opacity-0", "pointer-events-none");
        mobileOverlay?.classList.add("opacity-100", "pointer-events-auto");

        gsap.to(".line-1", { rotate: 45, y: 3, duration: 0.25 });
        gsap.to(".line-2", {
          rotate: -45,
          y: -3,
          width: "1.25rem",
          duration: 0.25,
        });

        gsap.fromTo(
          ".mobile-nav-item",
          { y: 15, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.3,
            stagger: 0.05,
            ease: "power2.out",
          },
        );
      } else {
        mobileOverlay?.classList.add("opacity-0", "pointer-events-none");
        mobileOverlay?.classList.remove("opacity-100", "pointer-events-auto");

        gsap.to(".line-1", { rotate: 0, y: 0, duration: 0.25 });
        gsap.to(".line-2", {
          rotate: 0,
          y: 0,
          width: "0.75rem",
          duration: 0.25,
        });
      }
    });

    document.querySelectorAll(".mobile-nav-item").forEach((link) => {
      link.addEventListener("click", () => {
        isMenuOpen = false;
        mobileOverlay?.classList.add("opacity-0", "pointer-events-none");
        gsap.to(".line-1", { rotate: 0, y: 0, duration: 0.25 });
        gsap.to(".line-2", {
          rotate: 0,
          y: 0,
          width: "0.75rem",
          duration: 0.25,
        });
      });
    });
  });
</script>

---
import { whatsappUrl } from "../../lib/constants";
---

<section
  id="contact"
  class="py-24 px-6 md:px-12 bg-serene-cream relative overflow-hidden"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- COLUMNA IZQUIERDA: MENSAJE EDITORIAL E INFORMACIÓN -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-3">
          <span
            class="text-[11px] uppercase tracking-[0.3em] text-serene-tan font-sans font-bold"
          >
            Private Booking • Dubai
          </span>
          <h2
            class="text-4xl md:text-5xl font-serif text-serene-navy leading-tight"
          >
            Begin Your Journey to Quietude
          </h2>
        </div>

        <p
          class="text-serene-navy/70 text-sm md:text-base font-sans font-light leading-relaxed"
        >
          Request your private at-home session or ask any questions regarding
          our Colombian body sculpting and lymphatic rituals. We respond
          promptly with full discretion.
        </p>

        <!-- CARACTERÍSTICAS DESTACADAS DE SERVICIO -->
        <div class="space-y-4 pt-4 border-t border-serene-gold/20">
          <div class="flex items-start space-x-4">
            <div
              class="w-8 h-8 rounded-full bg-serene-navy/5 border border-serene-navy/10 flex items-center justify-center shrink-0 mt-0.5"
            >
              <span class="text-serene-gold text-xs">✨</span>
            </div>
            <div>
              <h4 class="text-sm font-serif font-semibold text-serene-navy">
                At-Home Convenience
              </h4>
              <p class="text-xs font-sans text-serene-navy/60 font-light">
                Full professional setup brought to your residence across Dubai.
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div
              class="w-8 h-8 rounded-full bg-serene-navy/5 border border-serene-navy/10 flex items-center justify-center shrink-0 mt-0.5"
            >
              <span class="text-serene-gold text-xs">🌿</span>
            </div>
            <div>
              <h4 class="text-sm font-serif font-semibold text-serene-navy">
                Authentic Care
              </h4>
              <p class="text-xs font-sans text-serene-navy/60 font-light">
                Specialized therapists trained in authentic Colombian
                techniques.
              </p>
            </div>
          </div>
        </div>

        <!-- DIRECT CONTACT ALTERNATIVE -->
        <div
          class="p-6 bg-white/80 rounded-2xl border border-serene-gold/30 shadow-sm space-y-2"
        >
          <span
            class="text-[10px] uppercase tracking-widest text-serene-tan font-sans font-bold"
          >
            Prefer Direct Chat?
          </span>
          <p class="text-xs text-serene-navy/80 font-sans">
            Connect instantly with our team on WhatsApp for personalized
            recommendations.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-2 text-xs font-sans font-bold text-serene-navy hover:text-serene-gold transition-colors pt-1 cursor-pointer"
          >
            <span>Chat via WhatsApp</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- COLUMNA DERECHA: FORMULARIO DE RESERVA COMPACTO -->
      <div
        class="lg:col-span-7 bg-white rounded-3xl p-8 sm:p-10 border border-serene-gold/30 shadow-xl"
      >
        <form id="booking-form" class="space-y-6">
          <div class="space-y-1">
            <h3 class="text-2xl font-serif text-serene-navy">
              Reservation Request
            </h3>
            <p class="text-xs font-sans text-serene-navy/60">
              Fill in your preferred details below.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Full Name -->
            <div class="space-y-1.5">
              <label
                for="name"
                class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-serene-navy/80"
              >
                Full Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your Name"
                class="w-full bg-serene-cream/30 border border-serene-navy/15 rounded-xl px-4 py-3 text-xs font-sans text-serene-navy placeholder-serene-navy/40 focus:outline-none focus:border-serene-gold focus:ring-1 focus:ring-serene-gold transition-all"
              />
            </div>

            <!-- Phone / WhatsApp -->
            <div class="space-y-1.5">
              <label
                for="phone"
                class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-serene-navy/80"
              >
                WhatsApp Number
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="+971 50 000 0000"
                class="w-full bg-serene-cream/30 border border-serene-navy/15 rounded-xl px-4 py-3 text-xs font-sans text-serene-navy placeholder-serene-navy/40 focus:outline-none focus:border-serene-gold focus:ring-1 focus:ring-serene-gold transition-all"
              />
            </div>
          </div>

          <!-- Treatment Selection -->
          <div class="space-y-1.5">
            <label
              for="treatment"
              class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-serene-navy/80"
            >
              Select Treatment
            </label>
            <select
              id="treatment"
              name="treatment"
              required
              class="w-full bg-serene-cream/30 border border-serene-navy/15 rounded-xl px-4 py-3 text-xs font-sans text-serene-navy focus:outline-none focus:border-serene-gold focus:ring-1 focus:ring-serene-gold transition-all cursor-pointer"
            >
              <option value="" disabled selected>Choose a ritual...</option>
              <option value="Colombian Body Contouring"
                >Colombian Body Contouring</option
              >
              <option value="Brazilian Lymphatic Drainage"
                >Brazilian Lymphatic Drainage</option
              >
              <option value="Anti-Cellulite Massage"
                >Anti-Cellulite Massage</option
              >
              <option value="Buttock Lift Massage">Buttock Lift Massage</option>
              <option value="Post-Surgical Drainage"
                >Post-Surgical Drainage</option
              >
              <option value="Relaxation & Wellness Massage"
                >Relaxation & Wellness Massage</option
              >
              <option value="General Inquiry"
                >General Inquiry / Custom Advice</option
              >
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Preferred Date -->
            <div class="space-y-1.5">
              <label
                for="date"
                class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-serene-navy/80"
              >
                Preferred Date
              </label>
              <input
                type="date"
                id="date"
                name="date"
                class="w-full bg-serene-cream/30 border border-serene-navy/15 rounded-xl px-4 py-3 text-xs font-sans text-serene-navy focus:outline-none focus:border-serene-gold focus:ring-1 focus:ring-serene-gold transition-all cursor-pointer"
              />
            </div>

            <!-- Preferred Time Window -->
            <div class="space-y-1.5">
              <label
                for="time"
                class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-serene-navy/80"
              >
                Preferred Time
              </label>
              <select
                id="time"
                name="time"
                class="w-full bg-serene-cream/30 border border-serene-navy/15 rounded-xl px-4 py-3 text-xs font-sans text-serene-navy focus:outline-none focus:border-serene-gold focus:ring-1 focus:ring-serene-gold transition-all cursor-pointer"
              >
                <option value="Morning (9:00 AM - 12:00 PM)"
                  >Morning (9:00 AM - 12:00 PM)</option
                >
                <option value="Afternoon (12:00 PM - 4:00 PM)"
                  >Afternoon (12:00 PM - 4:00 PM)</option
                >
                <option value="Evening (4:00 PM - 8:00 PM)"
                  >Evening (4:00 PM - 8:00 PM)</option
                >
              </select>
            </div>
          </div>

          <!-- Notes / Location -->
          <div class="space-y-1.5">
            <label
              for="notes"
              class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-serene-navy/80"
            >
              Location / Additional Notes (Optional)
            </label>
            <textarea
              id="notes"
              name="notes"
              rows="3"
              placeholder="Your area in Dubai (e.g. Downtown, Marina, Palm Jumeirah)..."
              class="w-full bg-serene-cream/30 border border-serene-navy/15 rounded-xl p-4 text-xs font-sans text-serene-navy placeholder-serene-navy/40 focus:outline-none focus:border-serene-gold focus:ring-1 focus:ring-serene-gold transition-all resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full bg-serene-navy text-serene-cream hover:bg-serene-gold hover:text-serene-navy font-sans text-xs uppercase tracking-[0.2em] font-semibold py-4 rounded-xl transition-all duration-300 shadow-md cursor-pointer"
          >
            Send Reservation Request →
          </button>

          <p
            class="text-[10px] text-center text-serene-navy/50 font-sans italic"
          >
            Your privacy is guaranteed. We respect your discreet personal space.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- SCRIPT: REDIRECCIÓN AUTOMÁTICA A WHATSAPP -->
<script>
  window.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("booking-form") as HTMLFormElement;

    form?.addEventListener("submit", (e) => {
      e.preventDefault();

      const name = (document.getElementById("name") as HTMLInputElement).value;
      const phone = (document.getElementById("phone") as HTMLInputElement)
        .value;
      const treatment = (
        document.getElementById("treatment") as HTMLSelectElement
      ).value;
      const date = (document.getElementById("date") as HTMLInputElement).value;
      const time = (document.getElementById("time") as HTMLSelectElement).value;
      const notes = (document.getElementById("notes") as HTMLTextAreaElement)
        .value;

      let message = `Hello! I would like to request a reservation:\n\n`;
      message += `• *Name:* ${name}\n`;
      message += `• *Phone:* ${phone}\n`;
      message += `• *Treatment:* ${treatment}\n`;
      if (date) message += `• *Preferred Date:* ${date}\n`;
      if (time) message += `• *Preferred Time:* ${time}\n`;
      if (notes) message += `• *Location/Notes:* ${notes}\n`;

      const encodedMessage = encodeURIComponent(message);
      const whatsappUrl = `https://wa.me/971500000000?text=${encodedMessage}`; // Reemplazar con el número oficial

      window.open(whatsappUrl, "_blank");
    });
  });
</script>
